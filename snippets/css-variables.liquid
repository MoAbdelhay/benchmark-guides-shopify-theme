{%- comment -%} Theme-setting colours pushed into CSS custom properties. --c-* are the raw brand tokens used by colour schemes. {%- endcomment -%}
<style>
  :root{
    --c-bg:{{ settings.color_background }};
    --c-chalk:{{ settings.color_surface }};
    --c-ink:{{ settings.color_ink }};
    --c-ink-soft:{{ settings.color_ink_soft }};
    --c-accent:{{ settings.color_accent }};
    --c-accent-light:{{ settings.color_accent_light }};
    --c-flag:{{ settings.color_flag }};
    --bg:var(--c-bg);
    --bg-deep:{{ settings.color_background | color_darken: 4 }};
    --chalk:var(--c-chalk);
    --ink:var(--c-ink);
    --ink-soft:var(--c-ink-soft);
    --accent:var(--c-accent);
    --accent-light:var(--c-accent-light);
    --flag:var(--c-flag);
    --line:{{ settings.color_ink | color_modify: 'alpha', 0.16 }};
    --line-strong:{{ settings.color_ink | color_modify: 'alpha', 0.5 }};
    --grid:{{ settings.color_ink | color_modify: 'alpha', 0.05 }};
    --grid-major:{{ settings.color_ink | color_modify: 'alpha', 0.10 }};
    --panel:{{ settings.color_background | color_modify: 'alpha', 0.85 }};
    --disc-gen:{{ settings.color_disc_gen }};
    --disc-civ:{{ settings.color_disc_civ }};
    --disc-str:{{ settings.color_disc_str }};
    --disc-mec:{{ settings.color_disc_mec }};
    --disc-ele:{{ settings.color_disc_ele }};
    --disc-prc:{{ settings.color_disc_prc }};
    --max:{{ settings.page_width }}px;
  }
  {%- if settings.custom_css != blank -%}{{ settings.custom_css }}{%- endif -%}
</style>
