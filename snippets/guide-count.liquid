{%- comment -%}
  Arabic guide count with explicit plural forms (0, 1, 2, 3–10, 11–99, 100+).
  Usage: {% render 'guide-count', count: collection.products_count %}
{%- endcomment -%}
{%- liquid
  assign n = count | default: 0 | plus: 0
  assign r = n | modulo: 100
  if n == 0
    assign key = 'collections.general.count_zero'
  elsif n == 1
    assign key = 'collections.general.count_one'
  elsif n == 2
    assign key = 'collections.general.count_two'
  elsif r >= 3 and r <= 10
    assign key = 'collections.general.count_few'
  elsif r >= 11
    assign key = 'collections.general.count_many'
  else
    assign key = 'collections.general.count_other'
  endif
  echo key | t: count: n
-%}
