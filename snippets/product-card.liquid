{%- comment -%}
  Product card per Identity Standard §7: cover on a #E1E6E1 square, then
  "CODE · EL level", title, "96 pp · 42 worked examples", price + Add to cart.
  Usage: {% render 'product-card', product: product, lazy: true %}
{%- endcomment -%}
{%- liquid
  capture code
    render 'guide-meta', product: product, part: 'code'
  endcapture
  capture level
    render 'guide-meta', product: product, part: 'level'
  endcapture
  capture pages
    render 'guide-meta', product: product, part: 'pages'
  endcapture
  capture examples
    render 'guide-meta', product: product, part: 'examples'
  endcapture
  capture datum
    render 'guide-meta', product: product, part: 'datum'
  endcapture
  capture disc_name
    render 'guide-meta', product: product, part: 'name'
  endcapture
  assign code = code | strip
  assign level = level | strip
  assign pages = pages | strip
  assign examples = examples | strip
  assign datum = datum | strip
  assign is_new = false
  for tag in product.tags
    assign lt = tag | downcase
    if lt == 'new' or lt == 'new rev' or lt == 'new-rev'
      assign is_new = true
    endif
  endfor
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign variant = product.selected_or_first_available_variant
-%}
<article class="card reveal" data-product-card>
  <div class="card__media">
    {%- if product.featured_image -%}
      <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
          sizes="(max-width:600px) 60vw, 180px"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
          {% if lazy %}loading="lazy"{% endif %}>
      </a>
    {%- else -%}
      {% render 'cover', product: product %}
    {%- endif -%}
    {%- if is_new or on_sale or datum != blank or product.available == false -%}
      <div class="card__badges">
        {%- if product.available == false -%}<span class="badge badge--ink">{{ 'products.product.sold_out' | t }}</span>{%- endif -%}
        {%- if is_new -%}<span class="badge badge--flag">{{ 'products.product.new_rev' | t }}</span>{%- endif -%}
        {%- if on_sale and product.available -%}<span class="badge badge--flag">{{ 'products.product.sale' | t }}</span>{%- endif -%}
        {%- if datum != blank -%}<span class="badge badge--line">{{ 'products.product.datum' | t: letter: datum }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="card__body">
    <span class="label">{{ code }}{% if level != blank %} &middot; EL {{ level }}{% else %} &middot; {{ disc_name | strip }}{% endif %}</span>
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if pages != blank or examples != blank -%}
      <p class="card__meta">
        {%- if pages != blank -%}{{ 'products.product.pp' | t: count: pages }}{%- endif -%}
        {%- if pages != blank and examples != blank %} &middot; {% endif -%}
        {%- if examples != blank -%}{{ 'products.product.examples' | t: count: examples }}{%- endif -%}
      </p>
    {%- endif -%}
    <div class="card__foot">
      {% render 'price', product: product %}
      {%- if product.available and product.has_only_default_variant -%}
        {%- form 'product', product, data-product-form: '', class: 'card__form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="btn btn--sm" type="submit" data-add-to-cart><span data-add-to-cart-text>{{ 'products.product.add_to_cart' | t }}</span></button>
        {%- endform -%}
      {%- elsif product.available -%}
        <a class="btn btn--sm btn--outline" href="{{ product.url }}">{{ 'products.product.choose' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</article>
