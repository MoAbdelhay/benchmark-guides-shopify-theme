{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
  if heading == blank
    assign heading = 'general.password.heading' | t
  endif
  if text == blank
    assign text = 'general.password.text' | t
  endif
-%}
<div data-section-id="{{ section.id }}" style="max-width:760px;width:100%">
  <div class="brand" style="display:flex;flex-direction:column;align-items:center">
    <span class="mark"><span class="dot" aria-hidden="true"></span>{{ shop.name }}</span>
    <span class="sub">{{ 'sections.header.default_tagline' | t }}</span>
  </div>
  <h1 class="display h2">{{ heading }}</h1>
  <p class="lede" style="margin-inline:auto">{{ text }}</p>

  {%- form 'storefront_password', class: 'password-form' -%}
    {%- if form.errors -%}
      <p class="form-error">{{ form.errors.messages.form }}</p>
    {%- endif -%}
    <label class="visually-hidden" for="Password">{{ 'general.password.label' | t }}</label>
    <input id="Password" type="password" name="password" placeholder="{{ 'general.password.label' | t }}" autocomplete="current-password">
    <button class="btn" type="submit"><span>{{ 'general.password.submit' | t }}</span></button>
  {%- endform -%}

  <p class="label password__foot">{{ 'general.password.powered_by' | t }} {{ powered_by_link }}</p>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading_label", "info": "t:general.blank_uses_builtin" },
    { "type": "textarea", "id": "text", "label": "t:sections.hero.text_label", "info": "t:general.blank_uses_builtin" }
  ]
}
{% endschema %}
