<section class="container" data-section-id="{{ section.id }}">
  <div class="page-head">
    <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
    <h1 class="display h2">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="lede">{{ 'customer.reset_password.subtext' | t: email: email }}</p>
  </div>
  <div class="account">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-error"><ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul></div>
      {%- endif -%}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="btn btn--solid" type="submit"><span>{{ 'customer.reset_password.submit' | t }}</span></button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "settings": []
}
{% endschema %}
