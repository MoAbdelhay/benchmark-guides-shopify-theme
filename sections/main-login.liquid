<section class="container" data-section-id="{{ section.id }}">
  <div class="page-head">
    <p class="eyebrow">{{ 'customer.login.eyebrow' | t }}</p>
    <h1 class="display h2">{{ 'customer.login.title' | t }}</h1>
  </div>
  <div class="account">
    {%- form 'customer_login', id: 'CustomerLogin', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form-error"><ul>{%- for field in form.errors -%}<li>{{ form.errors.messages[field] }}</li>{%- endfor -%}</ul></div>
      {%- endif -%}
      <div class="field">
        <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      {%- if form.password_needed -%}
        <div class="field">
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
        </div>
      {%- endif -%}
      <div style="display:flex;gap:18px;align-items:center;flex-wrap:wrap">
        <button class="btn btn--solid" type="submit"><span>{{ 'customer.login.submit' | t }}</span></button>
        <a class="link label" href="#recover">{{ 'customer.login.forgot' | t }}</a>
      </div>
      <p class="form-note" style="margin-block-start:22px">{{ 'customer.login.no_account' | t }} <a class="link" href="{{ routes.account_register_url }}" style="color:var(--ink)">{{ 'customer.login.create_account' | t }}</a></p>
    {%- endform -%}

    <div id="recover" style="margin-block-start:48px;border-top:1px solid var(--line);padding-block-start:32px">
      <h2 class="display h4">{{ 'customer.recover_password.title' | t }}</h2>
      <p class="form-note" style="margin-block:8px 18px">{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password', id: 'RecoverForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success">{{ 'customer.recover_password.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form-error"><ul>{%- for field in form.errors -%}<li>{{ form.errors.messages[field] }}</li>{%- endfor -%}</ul></div>
        {%- endif -%}
        <div class="field">
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
        </div>
        <button class="btn" type="submit"><span>{{ 'customer.recover_password.submit' | t }}</span></button>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div style="margin-block-start:48px;border-top:1px solid var(--line);padding-block-start:32px">
        <h2 class="display h4">{{ 'customer.login.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          <button class="btn" type="submit" style="margin-block-start:14px"><span>{{ 'customer.login.guest_continue' | t }}</span></button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_login.name",
  "settings": []
}
{% endschema %}
