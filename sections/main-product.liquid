{%- liquid
  assign current = product.selected_or_first_available_variant
  capture code
    render 'guide-meta', product: product, part: 'code'
  endcapture
  capture rev
    render 'guide-meta', product: product, part: 'rev'
  endcapture
  capture rev_date
    render 'guide-meta', product: product, part: 'rev_date'
  endcapture
  capture level
    render 'guide-meta', product: product, part: 'level'
  endcapture
  capture level_name
    render 'guide-meta', product: product, part: 'level_name'
  endcapture
  capture disc_name
    render 'guide-meta', product: product, part: 'name'
  endcapture
  capture disc
    render 'guide-meta', product: product, part: 'disc'
  endcapture
  capture pages
    render 'guide-meta', product: product, part: 'pages'
  endcapture
  capture examples
    render 'guide-meta', product: product, part: 'examples'
  endcapture
  capture subtitle
    render 'guide-meta', product: product, part: 'subtitle'
  endcapture
  capture datum
    render 'guide-meta', product: product, part: 'datum'
  endcapture
  capture format
    render 'guide-meta', product: product, part: 'format'
  endcapture
  capture lang
    render 'guide-meta', product: product, part: 'lang'
  endcapture
  assign code = code | strip
  assign rev = rev | strip
  assign rev_date = rev_date | strip
  assign level = level | strip
  assign level_name = level_name | strip
  assign disc = disc | strip
  assign pages = pages | strip
  assign examples = examples | strip
  assign subtitle = subtitle | strip
  assign datum = datum | strip
-%}
<section class="container product" data-section-id="{{ section.id }}" data-product-section style="--disc:var(--disc-{{ disc }})">
  <div class="product__gallery">
    <div class="product__main-media">
      {%- if product.featured_media -%}
        {%- assign fm = current.featured_media | default: product.featured_media -%}
        <img
          data-main-image
          src="{{ fm | image_url: width: 1000 }}"
          srcset="{{ fm | image_url: width: 600 }} 600w, {{ fm | image_url: width: 1000 }} 1000w, {{ fm | image_url: width: 1400 }} 1400w"
          sizes="(max-width:860px) 92vw, 46vw"
          alt="{{ fm.alt | default: product.title | escape }}"
          width="{{ fm.width }}" height="{{ fm.height }}">
      {%- else -%}
        {% render 'cover', product: product, size: 'lg' %}
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="product__thumbs">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <button type="button" data-thumb data-src="{{ media | image_url: width: 1000 }}" data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w" data-alt="{{ media.alt | escape }}" {% if forloop.first %}aria-current="true"{% endif %} aria-label="{{ 'products.product.media' | t: index: forloop.index }}">
              <img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy" width="64" height="80">
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__head">
      <div class="label">
        <span class="code" data-sku>{{ code }}</span>
        {%- if level != blank -%}<span>&middot;</span><span>EL {{ level }}</span>{%- endif -%}
        <span>&middot;</span><span>{{ disc_name | strip }}</span>
        {%- if datum != blank -%}<span class="badge badge--line">{{ 'products.product.datum' | t: letter: datum }}</span>{%- endif -%}
      </div>
      {%- if section.settings.show_stamp -%}
        <div class="stamp" aria-label="{{ 'products.product.revision' | t: rev: rev }}">
          <b>REV {{ rev }}</b>
          {%- if rev_date != blank -%}<small>{{ rev_date }}</small>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <h1 class="display h1 product__title">{{ product.title }}</h1>
    {%- if subtitle != blank -%}<p class="product__sub">{{ subtitle }}</p>{%- endif -%}
    <div class="product__price">
      {% render 'price', product: product, variant: current, size: 'lg', id: 'ProductPrice' %}
      {%- if section.settings.show_tax_note -%}<span class="form-note">{{ 'products.product.tax_note' | t }}</span>{%- endif -%}
    </div>

    {%- if section.settings.show_specs -%}
      <div class="product__facts">
        {%- if pages != blank -%}
          <div class="dim" role="img" aria-label="{{ 'products.product.pp' | t: count: pages }}">
            <i class="tk"></i><i class="ar"></i><i class="ln"></i><span class="tx">{{ 'products.product.pp' | t: count: pages }}</span><i class="ln"></i><i class="ar r"></i><i class="tk"></i>
          </div>
        {%- endif -%}
        <div class="facts">
          {%- if examples != blank -%}<div class="fact"><span class="label">{{ 'products.product.examples_label' | t }}</span><b>{{ examples }}</b></div>{%- endif -%}
          {%- if level != blank -%}
            <div class="fact"><span class="label">{{ 'products.product.level' | t }}</span>
              <span class="lvl"><svg viewBox="0 0 24 16" aria-hidden="true"><path d="M4 1.5 H20 L12 13 Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M0 14.5 H24" stroke="currentColor" stroke-width="2"/></svg><span class="mono">EL {{ level }}</span><b>{{ level_name }}</b></span>
            </div>
          {%- endif -%}
          <div class="fact"><span class="label">{{ 'products.product.format' | t }}</span><b>{{ format | strip }}</b></div>
          <div class="fact"><span class="label">{{ 'products.product.language' | t }}</span><b>{{ lang | strip }}</b></div>
          <div class="fact"><span class="label">{{ 'products.product.delivery' | t }}</span><b>{{ 'products.product.delivery_value' | t }}</b></div>
        </div>
      </div>
    {%- endif -%}

    {%- form 'product', product, id: 'ProductForm', class: 'product__form', data-product-form: '', novalidate: 'novalidate' -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="variant-group" data-option-index="{{ forloop.index0 }}">
            <legend>{{ option.name }}</legend>
            <div class="pills">
              {%- for value in option.values -%}
                {%- assign oid = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                <div class="pill">
                  <input type="radio" id="{{ oid }}" name="{{ option.name }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ oid }}">{{ value }}</label>
                </div>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <input type="hidden" name="id" value="{{ current.id }}">

      {%- if section.settings.show_quantity -%}
        <div class="field" style="margin:0">
          <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <div class="qty">
            <button type="button" data-qty-change="-1" aria-label="{{ 'products.product.decrease' | t }}">&minus;</button>
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-change="1" aria-label="{{ 'products.product.increase' | t }}">+</button>
          </div>
        </div>
      {%- endif -%}

      <div class="buy-row">
        <button type="submit" class="btn" data-add-to-cart {% unless current.available %}disabled{% endunless %}>
          <span data-add-to-cart-text>{%- if current.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
        </button>
        {%- if section.settings.preview_url != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.preview_url }}" target="_blank" rel="noopener">{{ 'products.product.preview' | t: count: section.settings.preview_pages }}</a>
        {%- elsif product.metafields.custom.preview_url != blank -%}
          <a class="btn btn--outline" href="{{ product.metafields.custom.preview_url }}" target="_blank" rel="noopener">{{ 'products.product.preview' | t: count: section.settings.preview_pages }}</a>
        {%- endif -%}
      </div>
      {%- if settings.show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
      <p class="cart-note" data-cart-note aria-live="polite"></p>
    {%- endform -%}

    {%- if settings.show_trust -%}
      <ul class="product__trust">
        <li>{% render 'icon', name: 'download' %} {{ 'products.product.trust_instant' | t }}</li>
        <li>{% render 'icon', name: 'refresh' %} {{ 'products.product.trust_updates' | t: rev: rev }}</li>
        <li>{% render 'icon', name: 'lock' %} {{ 'products.product.trust_refund' | t }}</li>
      </ul>
    {%- endif -%}

    {%- if product.description != blank -%}
      <div class="product__description">
        <p class="eyebrow">{{ 'products.product.description' | t }}</p>
        <div class="rte">{{ product.description }}</div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'collapsible' -%}
          {%- if block.settings.content != blank or block.settings.page != blank -%}
            <div class="faq" style="margin-block-start:24px" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ block.settings.heading | default: 'products.product.inside' | t }}</summary>
                <div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
              </details>
            </div>
          {%- endif -%}
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{%- if section.settings.show_related -%}
  <section class="container section section--border-top">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ 'products.product.related_eyebrow' | t }}</p>
        <h2 class="display h2">{{ 'products.product.related' | t }}</h2>
      </div>
    </div>
    {%- assign related = product.collections.first.products | default: collections.all.products -%}
    <div class="grid grid--products">
      {%- assign shown = 0 -%}
      {%- for p in related -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p, lazy: true %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "sku": {{ code | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current.price | divided_by: 100.0 | json }},
    "availability": "http://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": [
    { "type": "checkbox", "id": "show_stamp", "label": "t:sections.main_product.stamp", "default": true },
    { "type": "checkbox", "id": "show_specs", "label": "t:sections.main_product.specs", "info": "t:sections.main_product.specs_info", "default": true },
    { "type": "checkbox", "id": "show_quantity", "label": "t:sections.main_product.quantity", "default": false },
    { "type": "checkbox", "id": "show_tax_note", "label": "t:sections.main_product.tax_note", "default": false },
    { "type": "url", "id": "preview_url", "label": "t:sections.main_product.preview_url", "info": "t:sections.main_product.preview_info" },
    { "type": "range", "id": "preview_pages", "label": "t:sections.main_product.preview_pages", "min": 1, "max": 20, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_related", "label": "t:sections.main_product.related", "default": true }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "t:sections.main_product.collapsible",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.main_product.collapsible_heading", "info": "t:general.blank_uses_builtin" },
        { "type": "richtext", "id": "content", "label": "t:sections.main_product.collapsible_content" },
        { "type": "page", "id": "page", "label": "t:sections.main_product.collapsible_page" }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
