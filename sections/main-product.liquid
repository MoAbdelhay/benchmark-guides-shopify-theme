{%- liquid
  assign current = product.selected_or_first_available_variant
  capture disc_css
    render 'guide-meta', product: product, part: 'css'
  endcapture
  capture code
    render 'guide-meta', product: product, part: 'code'
  endcapture
  capture rev
    render 'guide-meta', product: product, part: 'rev'
  endcapture
  capture disc_name
    render 'guide-meta', product: product, part: 'name'
  endcapture
  capture pages
    render 'guide-meta', product: product, part: 'pages'
  endcapture
  capture format
    render 'guide-meta', product: product, part: 'format'
  endcapture
  capture lang
    render 'guide-meta', product: product, part: 'lang'
  endcapture
-%}
<section class="container product" data-section-id="{{ section.id }}" data-product-section style="--disc:{{ disc_css | strip }}">
  <div class="product__gallery">
    <div class="product__main-media">
      {%- if product.featured_media -%}
        <span class="spine"></span>
        {%- assign fm = current.featured_media | default: product.featured_media -%}
        <img
          data-main-image
          src="{{ fm | image_url: width: 1000 }}"
          srcset="{{ fm | image_url: width: 600 }} 600w, {{ fm | image_url: width: 1000 }} 1000w, {{ fm | image_url: width: 1400 }} 1400w"
          sizes="(max-width:860px) 92vw, 46vw"
          alt="{{ fm.alt | default: product.title | escape }}"
          width="{{ fm.width }}" height="{{ fm.height }}">
      {%- else -%}
        {% render 'cover', product: product, size: 'lg' %}
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="product__thumbs">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <button type="button" data-thumb data-src="{{ media | image_url: width: 1000 }}" data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w" data-alt="{{ media.alt | escape }}" {% if forloop.first %}aria-current="true"{% endif %} aria-label="{{ 'products.product.media' | t: index: forloop.index }}">
              <img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy" width="64" height="80">
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="eyebrow">
      <span class="chip"><i></i><span data-sku>{{ code | strip }}</span></span>
      <span>{{ rev | strip }}</span>
      <span>{{ disc_name | strip }}</span>
    </div>
    <h1 class="display product__title">{{ product.title }}</h1>
    <div class="product__price">
      {% render 'price', product: product, variant: current, size: 'lg', id: 'ProductPrice' %}
      {%- if section.settings.show_tax_note -%}
        <span class="form-note">{{ 'products.product.tax_note' | t }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.show_specs -%}
      <div class="product__specs">
        {%- assign pages_s = pages | strip -%}
        {%- if pages_s != blank -%}
          <div class="spec"><span class="label">{{ 'products.product.pages' | t }}</span><b>{{ pages | strip }}</b></div>
        {%- endif -%}
        <div class="spec"><span class="label">{{ 'products.product.format' | t }}</span><b>{{ format | strip }}</b></div>
        <div class="spec"><span class="label">{{ 'products.product.language' | t }}</span><b>{{ lang | strip }}</b></div>
        <div class="spec"><span class="label">{{ 'products.product.delivery' | t }}</span><b>{{ 'products.product.delivery_value' | t }}</b></div>
      </div>
    {%- endif -%}

    {%- form 'product', product, id: 'ProductForm', class: 'product__form', data-product-form: '', novalidate: 'novalidate' -%}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="variant-group" data-option-index="{{ forloop.index0 }}">
            <legend>{{ option.name }}</legend>
            <div class="pills">
              {%- for value in option.values -%}
                {%- assign oid = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                <div class="pill">
                  <input type="radio" id="{{ oid }}" name="{{ option.name }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ oid }}">{{ value }}</label>
                </div>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <input type="hidden" name="id" value="{{ current.id }}">

      {%- if section.settings.show_quantity -%}
        <div class="field" style="margin:0">
          <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <div class="qty">
            <button type="button" data-qty-change="-1" aria-label="{{ 'products.product.decrease' | t }}">&minus;</button>
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-change="1" aria-label="{{ 'products.product.increase' | t }}">+</button>
          </div>
        </div>
      {%- endif -%}

      <div class="buy-row">
        <button type="submit" class="btn btn--solid" data-add-to-cart {% unless current.available %}disabled{% endunless %}>
          <span data-add-to-cart-text>{%- if current.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
        </button>
      </div>
      {%- if settings.show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
      <p class="cart-note" data-cart-note aria-live="polite"></p>
    {%- endform -%}

    {%- if settings.show_trust -%}
      <ul class="product__trust">
        <li>{% render 'icon', name: 'download' %} {{ 'products.product.trust_instant' | t }}</li>
        <li>{% render 'icon', name: 'refresh' %} {{ 'products.product.trust_updates' | t }}</li>
        <li>{% render 'icon', name: 'lock' %} {{ 'products.product.trust_secure' | t }}</li>
      </ul>
    {%- endif -%}

    {%- if product.description != blank -%}
      <div class="product__description">
        <p class="eyebrow">{{ 'products.product.description' | t }}</p>
        <div class="rte">{{ product.description }}</div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'collapsible' -%}
          <div class="faq" style="margin-block-start:26px" {{ block.shopify_attributes }}>
            <details>
              <summary>{{ block.settings.heading }}</summary>
              <div class="rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
            </details>
          </div>
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
</section>

{%- if section.settings.show_related -%}
  <section class="container section section--border-top">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ 'products.product.related_eyebrow' | t }}</p>
        <h2 class="display h2">{{ 'products.product.related' | t }}</h2>
      </div>
    </div>
    {%- assign related = product.collections.first.products | default: collections.all.products -%}
    <div class="grid grid--products">
      {%- assign shown = 0 -%}
      {%- for p in related -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p, index: forloop.index, lazy: true %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "sku": {{ current.sku | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current.price | divided_by: 100.0 | json }},
    "availability": "http://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": [
    { "type": "checkbox", "id": "show_specs", "label": "t:sections.main_product.specs", "info": "t:sections.main_product.specs_info", "default": true },
    { "type": "checkbox", "id": "show_quantity", "label": "t:sections.main_product.quantity", "default": false },
    { "type": "checkbox", "id": "show_tax_note", "label": "t:sections.main_product.tax_note", "default": false },
    { "type": "checkbox", "id": "show_related", "label": "t:sections.main_product.related", "default": true }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "t:sections.main_product.collapsible",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.main_product.collapsible_heading", "default": "What's inside" },
        { "type": "richtext", "id": "content", "label": "t:sections.main_product.collapsible_content" },
        { "type": "page", "id": "page", "label": "t:sections.main_product.collapsible_page" }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
