<section class="container" data-section-id="{{ section.id }}">
  <div class="page-head">
    <p class="eyebrow">{{ 'general.page.eyebrow' | t }}</p>
    <h1 class="display h2">{{ page.title }}</h1>
  </div>
  <div class="rte">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": []
}
{% endschema %}
