{%- liquid
  assign tagline = section.settings.tagline
  if tagline == blank
    assign tagline = 'sections.header.default_tagline' | t
  endif
-%}
<header class="site-header{% if section.settings.sticky %} is-sticky{% endif %}" data-section-id="{{ section.id }}">
  <div class="brand">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        <img class="logo logo--custom" src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}">
      {%- else -%}
        {%- comment -%} Identity Standard §2: primary logo at 200–220 px desktop, 150 px mobile. Never retype the name. {%- endcomment -%}
        <img class="logo" src="{{ 'logo-primary.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="1123" height="170">
      {%- endif -%}
    </a>
    {%- if section.settings.show_tagline -%}<span class="sub">{{ tagline }}</span>{%- endif -%}
  </div>

  <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="SiteNav">{{ 'sections.header.menu' | t }}</button>

  <nav class="site-nav" id="SiteNav" aria-label="{{ 'sections.header.menu' | t }}">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="utils">
    {%- if section.settings.show_localization -%}
      {% render 'localization', id: 'header' %}
    {%- endif -%}
    {%- if section.settings.show_search -%}
      <a href="{{ routes.search_url }}">{{ 'general.search.title' | t }}</a>
    {%- endif -%}
    {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{{ 'sections.header.account' | t }}</a>
    {%- endif -%}
    <a class="cart-link" href="{{ routes.cart_url }}">
      {{ 'general.cart.title' | t }}
      <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.header.logo", "info": "t:sections.header.logo_info" },
    { "type": "checkbox", "id": "show_tagline", "label": "t:sections.header.show_tagline", "default": true },
    { "type": "text", "id": "tagline", "label": "t:sections.header.tagline", "info": "t:general.blank_uses_builtin" },
    { "type": "link_list", "id": "menu", "label": "t:sections.header.menu_label", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "t:sections.header.sticky", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "t:sections.header.localization", "info": "t:sections.header.localization_info", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "t:sections.header.search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "t:sections.header.account_toggle", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
