{%- liquid
  assign tagline = section.settings.tagline
  if tagline == blank
    assign tagline = 'sections.footer.default_tagline' | t
  endif
-%}
<footer class="site-footer" data-section-id="{{ section.id }}">
  <div class="site-footer__grid">
    <div class="brand">
      <a class="mark" href="{{ routes.root_url }}"><span class="dot" aria-hidden="true"></span>{{ shop.name }}</a>
      <p>{{ tagline }}</p>
      {%- if section.settings.show_localization -%}
        <div style="margin-block-start:18px">{% render 'localization', id: 'footer' %}</div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          {%- liquid
            assign heading = block.settings.heading
            if heading == blank
              assign heading = block.settings.menu.title
            endif
          -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ heading }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a class="link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'text' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <div class="rte" style="font-size:14px;color:var(--ink-soft)">{{ block.settings.text }}</div>
          </div>
        {%- when 'newsletter' -%}
          <div {{ block.shopify_attributes }}>
            <h3>{{ 'general.newsletter.label' | t }}</h3>
            {%- form 'customer', id: 'FooterNewsletter', class: 'news' -%}
              <p class="form-note">{{ 'general.newsletter.subtext' | t }}</p>
              {%- if form.posted_successfully? -%}
                <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
              {%- elsif form.errors -%}
                <p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div style="display:flex;border:1px solid var(--ink);border-radius:var(--radius);overflow:hidden">
                <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.email' | t }}</label>
                <input id="FooterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'general.newsletter.email' | t }}" required autocomplete="email" style="flex:1;border:0;background:transparent;padding:12px 14px;min-width:0">
                <button class="btn btn--sm" type="submit" style="border:0;border-inline-start:1px solid var(--ink);border-radius:0"><span>{{ 'general.newsletter.button' | t }}</span></button>
              </div>
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="site-footer__bottom">
    <div>
      &copy; {{ 'now' | date: '%Y' }} <a href="{{ routes.root_url }}">{{ shop.name }}</a> &middot; {{ 'sections.footer.rights' | t }}
      {%- if section.settings.show_powered -%} &middot; <a href="https://www.shopify.com" rel="nofollow" target="_blank">{{ powered_by_link | strip_html }}</a>{%- endif -%}
    </div>

    {%- assign has_social = false -%}
    {%- if settings.social_instagram != blank or settings.social_x != blank or settings.social_youtube != blank or settings.social_linkedin != blank or settings.social_telegram != blank -%}{%- assign has_social = true -%}{%- endif -%}
    {%- if has_social -%}
      <ul class="social" aria-label="{{ 'sections.footer.social' | t }}">
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
        {%- if settings.social_x != blank -%}<li><a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'x' %}</a></li>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
        {%- if settings.social_linkedin != blank -%}<li><a href="{{ settings.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">{% render 'icon', name: 'linkedin' %}</a></li>{%- endif -%}
        {%- if settings.social_telegram != blank -%}<li><a href="{{ settings.social_telegram }}" target="_blank" rel="noopener" aria-label="Telegram">{% render 'icon', name: 'telegram' %}</a></li>{%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "text", "id": "tagline", "label": "t:sections.footer.tagline", "info": "t:general.blank_uses_builtin" },
    { "type": "checkbox", "id": "show_localization", "label": "t:sections.header.localization", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.payment_icons", "default": true },
    { "type": "checkbox", "id": "show_powered", "label": "t:sections.footer.powered", "default": false }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.block_menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.block_heading", "info": "t:sections.footer.block_heading_info" },
        { "type": "link_list", "id": "menu", "label": "t:sections.footer.block_menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.block_text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.block_heading" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.block_text" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.block_newsletter",
      "limit": 1,
      "settings": []
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
