{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign text = section.settings.text
  if eyebrow == blank
    assign eyebrow = 'sections.rich_text.eyebrow' | t
  endif
  if heading == blank
    assign heading = 'sections.rich_text.heading' | t
  endif
  if text == blank
    assign text = 'sections.rich_text.text' | t
  endif
  assign scheme = section.settings.scheme
-%}
<section class="scheme-{{ scheme }}{% if scheme == 'ink' or scheme == 'bronze' %} survey-grid{% endif %}" data-section-id="{{ section.id }}">
  <div class="container section{% if scheme == 'vellum' %} section--border-top{% endif %}">
    <div class="rich{% if section.settings.align == 'start' %} rich--start{% endif %}">
      <p class="eyebrow reveal">{{ eyebrow }}</p>
      <h2 class="display h2 reveal">{{ heading }}</h2>
      <div class="lede reveal">{{ text }}</div>
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="btn reveal" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_stats -%}
      <div class="stats reveal">
        {%- for block in section.blocks -%}
          <div class="stat" {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span class="label">{{ block.settings.label }}</span></div>
        {%- endfor -%}
        {%- if section.blocks.size == 0 -%}
          <div class="stat"><b>{{ collections.all.products_count }}</b><span class="label">{{ 'sections.rich_text.stat_guides' | t }}</span></div>
          <div class="stat"><b>6</b><span class="label">{{ 'sections.rich_text.stat_disciplines' | t }}</span></div>
          <div class="stat"><b>2</b><span class="label">{{ 'sections.rich_text.stat_languages' | t }}</span></div>
          <div class="stat"><b>&infin;</b><span class="label">{{ 'sections.rich_text.stat_updates' | t }}</span></div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    {
      "type": "select", "id": "scheme", "label": "t:general.scheme", "default": "vellum",
      "options": [
        { "value": "vellum", "label": "t:general.scheme_vellum" },
        { "value": "chalk", "label": "t:general.scheme_chalk" },
        { "value": "ink", "label": "t:general.scheme_ink" },
        { "value": "bronze", "label": "t:general.scheme_bronze" }
      ]
    },
    { "type": "select", "id": "align", "label": "t:sections.rich_text.align", "options": [{ "value": "center", "label": "t:sections.rich_text.center" }, { "value": "start", "label": "t:sections.rich_text.start" }], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow_label", "info": "t:general.blank_uses_builtin" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading_label", "info": "t:general.blank_uses_builtin" },
    { "type": "richtext", "id": "text", "label": "t:sections.hero.text_label", "info": "t:general.blank_uses_builtin" },
    { "type": "text", "id": "cta_label", "label": "t:sections.hero.cta_label" },
    { "type": "url", "id": "cta_url", "label": "t:sections.hero.cta_url" },
    { "type": "checkbox", "id": "show_stats", "label": "t:sections.rich_text.show_stats", "default": true }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:sections.rich_text.stat",
      "settings": [
        { "type": "text", "id": "value", "label": "t:sections.rich_text.stat_value", "default": "42" },
        { "type": "text", "id": "label", "label": "t:sections.rich_text.stat_label", "default": "دليل صادر" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "t:sections.rich_text.name" }]
}
{% endschema %}
