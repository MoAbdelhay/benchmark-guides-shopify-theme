{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign text = section.settings.text
  if eyebrow == blank
    assign eyebrow = 'sections.rich_text.eyebrow' | t
  endif
  if heading == blank
    assign heading = 'sections.rich_text.heading' | t
  endif
  if text == blank
    assign text = 'sections.rich_text.text' | t
  endif
-%}
<section class="container section section--border-top" data-section-id="{{ section.id }}">
  <div class="rich{% if section.settings.align == 'start' %} rich--start{% endif %}">
    <p class="eyebrow reveal">{{ eyebrow }}</p>
    <h2 class="display h2 reveal">{{ heading }}</h2>
    <div class="lede reveal">{{ text }}</div>
    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <a class="btn reveal" href="{{ section.settings.cta_url }}"><span>{{ section.settings.cta_label }}</span></a>
    {%- endif -%}
  </div>
  {%- if section.settings.show_stats -%}
    <div class="stats reveal" style="margin-block-start:clamp(32px,5vw,64px)">
      {%- for block in section.blocks -%}
        <div class="stat" {{ block.shopify_attributes }}>
          <span class="serial">{{ block.settings.value }}</span>
          <span class="label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
      {%- if section.blocks.size == 0 -%}
        <div class="stat"><span class="serial">{{ collections.all.products_count }}</span><span class="label">{{ 'sections.rich_text.stat_guides' | t }}</span></div>
        <div class="stat"><span class="serial">6</span><span class="label">{{ 'sections.rich_text.stat_disciplines' | t }}</span></div>
        <div class="stat"><span class="serial">2</span><span class="label">{{ 'sections.rich_text.stat_languages' | t }}</span></div>
        <div class="stat"><span class="serial">&infin;</span><span class="label">{{ 'sections.rich_text.stat_updates' | t }}</span></div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    { "type": "select", "id": "align", "label": "t:sections.rich_text.align", "options": [{ "value": "center", "label": "t:sections.rich_text.center" }, { "value": "start", "label": "t:sections.rich_text.start" }], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow_label", "info": "t:general.blank_uses_builtin" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading_label", "info": "t:general.blank_uses_builtin" },
    { "type": "richtext", "id": "text", "label": "t:sections.hero.text_label", "info": "t:general.blank_uses_builtin" },
    { "type": "text", "id": "cta_label", "label": "t:sections.hero.cta_label" },
    { "type": "url", "id": "cta_url", "label": "t:sections.hero.cta_url" },
    { "type": "checkbox", "id": "show_stats", "label": "t:sections.rich_text.show_stats", "default": true }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:sections.rich_text.stat",
      "settings": [
        { "type": "text", "id": "value", "label": "t:sections.rich_text.stat_value", "default": "120+" },
        { "type": "text", "id": "label", "label": "t:sections.rich_text.stat_label", "default": "Guides" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "t:sections.rich_text.name" }]
}
{% endschema %}
