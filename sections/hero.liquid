{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign cta = section.settings.cta_label
  assign cta2 = section.settings.cta2_label
  if heading == blank
    assign heading = 'sections.hero.heading' | t
  endif
  if text == blank
    assign text = 'sections.hero.text' | t
  endif
  if cta == blank
    assign cta = 'sections.hero.cta' | t
  endif
  if cta2 == blank
    assign cta2 = 'sections.hero.cta2' | t
  endif
  assign cta_url = section.settings.cta_url | default: routes.all_products_collection_url
  assign cta2_url = section.settings.cta2_url | default: routes.collections_url
  assign guide_count = collections.all.products_count
  assign disc_list = 'gen,civ,str,mec,ele,prc' | split: ','
  assign sheet_no = section.settings.sheet_no
  if sheet_no == blank
    assign sheet_no = settings.guide_code_prefix | default: 'BG' | append: '-WEB-001'
  endif
-%}
{%- comment -%} Identity Standard §5/§7: the hero is a drawing title sheet — frame, zone strip, survey grid, thesis, title block. {%- endcomment -%}
<section class="container" data-section-id="{{ section.id }}">
  <div class="title-sheet">
    <div class="title-sheet__frame">
      <div class="zones" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span></div>
      <div class="sheet-body survey-grid">
        {%- if section.settings.show_logo -%}
          <img class="hero-logo reveal" src="{{ 'logo-primary.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="1123" height="170">
        {%- endif -%}
        <h1 class="thesis reveal">
          <svg viewBox="0 0 24 16" aria-hidden="true"><path d="M4 1.5 H20 L12 13 Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M0 14.5 H24" stroke="currentColor" stroke-width="2"/></svg>
          <span>{{ heading }}</span>
        </h1>
        <p class="hero-sub reveal">{{ text }}</p>
        <div class="hero__actions reveal">
          <a class="btn" href="{{ cta_url }}">{{ cta }}</a>
          <a class="btn btn--outline" href="{{ cta2_url }}">{{ cta2 }}</a>
        </div>
        {%- if section.settings.show_disciplines -%}
          <div class="hero__palette reveal" aria-label="{{ 'products.discipline.label' | t }}">
            {%- for d in disc_list -%}
              {%- assign d_key = 'products.discipline.' | append: d -%}
              <a href="{{ routes.all_products_collection_url }}/{{ d }}" style="--disc:var(--disc-{{ d }})"><i></i>{{ d | upcase }} &middot; {{ d_key | t }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="title-block">
        <div class="tb wide"><span class="label">{{ 'sections.hero.tb_client' | t }}</span><b>{{ shop.name }}</b></div>
        <div class="tb wide"><span class="label">{{ 'sections.hero.tb_title' | t }}</span><b>{{ 'sections.hero.tb_title_value' | t }}</b></div>
        <div class="tb"><span class="label">{{ 'sections.hero.tb_no' | t }}</span><b class="code">{{ sheet_no }}</b></div>
        <div class="tb"><span class="label">{{ 'sections.hero.tb_guides' | t }}</span><b class="code">{{ guide_count }}</b></div>
        <div class="tb"><span class="label">{{ 'sections.hero.tb_language' | t }}</span><b>{{ 'sections.hero.tb_language_value' | t }}</b></div>
        <div class="tb"><span class="label">{{ 'sections.hero.tb_date' | t }}</span><b class="code">{{ 'now' | date: '%Y-%m' }}</b></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    { "type": "paragraph", "content": "t:general.blank_uses_builtin_long" },
    { "type": "checkbox", "id": "show_logo", "label": "t:sections.hero.show_logo", "default": true },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading_label" },
    { "type": "textarea", "id": "text", "label": "t:sections.hero.text_label" },
    { "type": "text", "id": "cta_label", "label": "t:sections.hero.cta_label" },
    { "type": "url", "id": "cta_url", "label": "t:sections.hero.cta_url" },
    { "type": "text", "id": "cta2_label", "label": "t:sections.hero.cta2_label" },
    { "type": "url", "id": "cta2_url", "label": "t:sections.hero.cta2_url" },
    { "type": "text", "id": "sheet_no", "label": "t:sections.hero.sheet_no", "info": "t:general.blank_uses_builtin" },
    { "type": "checkbox", "id": "show_disciplines", "label": "t:sections.hero.show_disciplines", "default": true }
  ],
  "presets": [{ "name": "t:sections.hero.name" }]
}
{% endschema %}
