{%- liquid
  assign collection = section.settings.collection | default: collections.all
  assign heading = section.settings.heading
  assign eyebrow = section.settings.eyebrow
  if heading == blank
    assign heading = 'sections.featured_collection.heading' | t
  endif
  if eyebrow == blank
    assign eyebrow = 'sections.featured_collection.eyebrow' | t
  endif
  assign limit = section.settings.limit
-%}
<section class="container section section--border-top" data-section-id="{{ section.id }}">
  <div class="section-head">
    <div>
      <p class="eyebrow">{{ eyebrow }}</p>
      <h2 class="display h2">{{ heading }}</h2>
    </div>
    {%- if section.settings.show_view_all and collection.products_count > limit -%}
      <a class="link arrow-link" href="{{ collection.url }}">{{ 'collections.general.view_all' | t: count: collection.products_count }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>

  {%- if collection.products.size > 0 -%}
    <div class="grid grid--products">
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', product: product, lazy: true %}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%} Placeholder cards until products exist. Example content per the Identity Standard. {%- endcomment -%}
    {%- assign codes = 'BG-STR-101,BG-STR-204,BG-STR-310,BG-CIV-112' | split: ',' -%}
    {%- assign discs = 'str,str,str,civ' | split: ',' -%}
    {%- assign levels = '100,200,300,100' | split: ',' -%}
    <div class="grid grid--products">
      {%- assign ph_title = 'sections.featured_collection.placeholder_title' | t -%}
      {%- for code in codes -%}
        {%- assign ph_level = levels[forloop.index0] -%}
        {%- assign ph_disc = discs[forloop.index0] -%}
        <article class="card reveal">
          <div class="card__media">
            {% render 'cover', title: ph_title, code: code, rev: 'A', level: ph_level, disc: ph_disc %}
          </div>
          <div class="card__body">
            <span class="label">{{ code }} &middot; EL {{ ph_level }}</span>
            <h3 class="card__title">{{ ph_title }}</h3>
            <p class="card__meta">{{ 'sections.featured_collection.placeholder_hint' | t }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.collection" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow_label", "info": "t:general.blank_uses_builtin" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading_label", "info": "t:general.blank_uses_builtin" },
    { "type": "range", "id": "limit", "label": "t:sections.featured_collection.limit", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.featured_collection.view_all", "default": true }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
