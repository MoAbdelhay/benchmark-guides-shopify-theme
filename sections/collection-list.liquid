{%- liquid
  assign heading = section.settings.heading
  assign eyebrow = section.settings.eyebrow
  if heading == blank
    assign heading = 'sections.collection_list.heading' | t
  endif
  if eyebrow == blank
    assign eyebrow = 'sections.collection_list.eyebrow' | t
  endif
  assign disc_list = 'gen,civ,str,mec,ele,prc' | split: ','
-%}
{%- comment -%} Identity Standard §3: discipline colour appears only on Datum Ink, here as a collection tab stripe. {%- endcomment -%}
<section class="container section section--border-top" data-section-id="{{ section.id }}">
  <div class="section-head">
    <div>
      <p class="eyebrow">{{ eyebrow }}</p>
      <h2 class="display h2">{{ heading }}</h2>
    </div>
    <a class="link arrow-link" href="{{ routes.collections_url }}">{{ 'collections.general.browse' | t }} {% render 'icon', name: 'arrow' %}</a>
  </div>
  <div class="grid grid--3">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign d = disc_list[forloop.index0] | default: 'gen' -%}
        {%- if block.settings.discipline != blank -%}{%- assign d = block.settings.discipline -%}{%- endif -%}
        {%- assign d_key = 'products.discipline.' | append: d -%}
        {%- assign desc_key = 'products.discipline_desc.' | append: d -%}
        {%- assign desc = block.settings.description -%}
        {%- if desc == blank -%}{%- assign desc = desc_key | t -%}{%- endif -%}
        {%- assign title = c.title | default: block.settings.title -%}
        {%- if title == blank -%}{%- assign title = d_key | t -%}{%- endif -%}
        <a class="coll reveal" href="{{ c.url | default: routes.collections_url }}" style="--disc:var(--disc-{{ d }})" {{ block.shopify_attributes }}>
          <span class="coll__code">{{ d | upcase }}</span>
          <span class="coll__title">{{ title }}</span>
          <span class="coll__desc">{{ desc }}</span>
          {%- if c != blank and c.products_count > 0 -%}<span class="coll__count">{% render 'guide-count', count: c.products_count %}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for c in collections limit: 6 -%}
        {%- assign d = disc_list[forloop.index0] | default: 'gen' -%}
        {%- assign desc_key = 'products.discipline_desc.' | append: d -%}
        {%- assign desc = c.description | strip_html | truncatewords: 22 -%}
        {%- if desc == blank -%}{%- assign desc = desc_key | t -%}{%- endif -%}
        <a class="coll reveal" href="{{ c.url }}" style="--disc:var(--disc-{{ d }})">
          <span class="coll__code">{{ d | upcase }}</span>
          <span class="coll__title">{{ c.title }}</span>
          <span class="coll__desc">{{ desc }}</span>
          {%- if c.products_count > 0 -%}<span class="coll__count">{% render 'guide-count', count: c.products_count %}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.hero.eyebrow_label", "info": "t:general.blank_uses_builtin" },
    { "type": "text", "id": "heading", "label": "t:sections.hero.heading_label", "info": "t:general.blank_uses_builtin" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.block",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection_list.block" },
        {
          "type": "select", "id": "discipline", "label": "t:sections.collection_list.discipline",
          "options": [
            { "value": "", "label": "t:sections.collection_list.auto" },
            { "value": "gen", "label": "GEN" }, { "value": "civ", "label": "CIV" }, { "value": "str", "label": "STR" },
            { "value": "mec", "label": "MEC" }, { "value": "ele", "label": "ELE" }, { "value": "prc", "label": "PRC" }
          ],
          "default": ""
        },
        { "type": "textarea", "id": "description", "label": "t:sections.collection_list.description", "info": "t:sections.collection_list.description_info" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "t:sections.collection_list.name", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
