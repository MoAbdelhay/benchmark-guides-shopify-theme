      { "type": "checkbox", "id": "show_sku", "label": "t:settings_schema.products.sku", "default": true }
    ]
  },
  {
    "name": "t:settings_schema.custom_css.name",
    "settings": [
      { "type": "textarea", "id": "custom_css", "label": "t:settings_schema.custom_css.label", "info": "t:settings_schema.custom_css.info" }
    ]
  }
