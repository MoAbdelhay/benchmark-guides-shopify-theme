      { "type": "color", "id": "color_disc_gen", "label": "GEN", "default": "#7C8A93" },
      { "type": "color", "id": "color_disc_civ", "label": "CIV", "default": "#B5763A" },
      { "type": "color", "id": "color_disc_str", "label": "STR", "default": "#5B87A3" },
      { "type": "color", "id": "color_disc_mec", "label": "MEC", "default": "#5F8A6A" },
      { "type": "color", "id": "color_disc_ele", "label": "ELE", "default": "#D6A637" },
      { "type": "color", "id": "color_disc_prc", "label": "PRC", "default": "#8A78AE" }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      { "type": "range", "id": "page_width", "label": "t:settings_schema.layout.page_width", "min": 1100, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
      { "type": "checkbox", "id": "show_grain", "label": "t:settings_schema.layout.grain", "default": true },
      { "type": "checkbox", "id": "show_vignette", "label": "t:settings_schema.layout.vignette", "default": true },
      { "type": "checkbox", "id": "show_regmarks", "label": "t:settings_schema.layout.regmarks", "default": true }
    ]
  },
  {
    "name": "t:settings_schema.brand.name",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "t:settings_schema.brand.favicon" },
      { "type": "text", "id": "guide_code_prefix", "label": "t:settings_schema.brand.code_prefix", "info": "t:settings_schema.brand.code_prefix_info", "default": "BG" },
      { "type": "header", "content": "t:settings_schema.brand.social" },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_x", "label": "X" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
      { "type": "url", "id": "social_telegram", "label": "Telegram" }
