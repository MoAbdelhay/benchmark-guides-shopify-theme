      { "type": "color", "id": "color_accent", "label": "t:settings_schema.colors.accent", "default": "#8E5A1C" },
      { "type": "color", "id": "color_accent_light", "label": "t:settings_schema.colors.accent_light", "default": "#C98B3E" },
      { "type": "color", "id": "color_flag", "label": "t:settings_schema.colors.flag", "info": "t:settings_schema.colors.flag_info", "default": "#EC6435" },
